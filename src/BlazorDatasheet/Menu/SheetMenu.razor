@using BlazorDatasheet.Services
@inject IMenuService MenuService
@inherits SheetComponentBase
@implements IAsyncDisposable
@implements IMenu

<CascadingValue Value="@MenuId">
    <CascadingValue Value="@CurrentContext" Name="Context">
        <CascadingValue Value="@Disabled">
            <div id="@MenuId" popover="manual" class="bds-sheet-popover">
                <div class="bds-sheet-menu">
                    @ChildContent(CurrentContext)
                </div>
            </div>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>

<style>
    .bds-sheet-menu {
        display: flex;
        flex-direction: column;
        background: var(--sheet-menu-bg-color);
        border: var(--sheet-border-width) solid var(--sheet-menu-border-color);
        border-radius: 7px;
        box-shadow: 0 1px 2px var(--sheet-menu-shadow-color),
                    0 14px 32px -12px var(--sheet-menu-shadow-color);
        padding: 4px;
        min-width: 214px;
        max-height: 100vh;
        /* Scrolls here rather than on the popover, so the popover can stay overflow:visible
           and let the menu's shadow render outside its box. hidden-x keeps the radius clipping. */
        overflow: hidden auto;
        box-sizing: border-box;
        font-size: 0.8rem;
        font-family: var(--sheet-font-family), sans-serif;
        font-weight: var(--sheet-font-weight);
        color: var(--sheet-foreground-color);
    }

    /* Panels supply their own edge-to-edge sections, so the menu drops its inner padding. */
    .bds-sheet-menu:has(> .bds-sheet-menu-panel) {
        padding: 0;
        min-width: 0;
    }

    .bds-sheet-popover {
        position: fixed;
        inset: 0;
        width: fit-content;
        height: fit-content;
        margin: 0;
        padding: 0;
        overflow: visible;
        border: none;
        background: transparent;
    }

</style>

@code {

    [Parameter, EditorRequired] public RenderFragment<object?> ChildContent { get; set; } = default!;

    [Parameter] public string MenuId { get; set; } = Guid.NewGuid().ToString();

    [Parameter] public string? ParentMenuId { get; set; } = null;

    [Parameter] public EventCallback<MenuShownEventArgs> OnMenuOpen { get; set; }

    [Parameter] public EventCallback OnMenuClose { get; set; }

    [Parameter] public bool Disabled { get; set; }

    public object? CurrentContext { get; set; } = null;

    protected override void OnInitialized()
    {
        MenuService.MenuShown += HandleMenuShown;
    }

    private void HandleMenuShown(object? sender, MenuShownEventArgs args)
    {
        if (args.MenuId != this.MenuId)
            return;

        this.CurrentContext = args.Context;
        this.StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await MenuService.RegisterMenu(MenuId, this, ParentMenuId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        // IMenuService is scoped, so a missed unsubscribe leaks for the life of the circuit
        MenuService.MenuShown -= HandleMenuShown;
        await MenuService.UnregisterMenu(MenuId);
    }

}
@using BlazorDatasheet.Services
@using Microsoft.JSInterop
@using static BlazorDatasheet.Util.JsInteropHelper
@inject IMenuService MenuService;
@inherits SheetComponentBase
@implements IAsyncDisposable
@inject IJSRuntime _js;

<div
    @ref="_menuTarget"
    class="bds-sheet-menu-target"
    id="@TargetId"
    @onclick="TargetOnClick"
    @onclick:preventDefault="@(Trigger == MenuTrigger.OnClick)"
    @onmousedown="TargetOnMouseDown"
    @onmousedown:preventDefault="@(Trigger == MenuTrigger.OnPress)"
    @onmouseover="TargetOnHover"
    @onmouseover:preventDefault="@(Trigger == MenuTrigger.OnHover)">
    @ChildContent
</div>


<style>
    .bds-sheet-menu-target {

    }
</style>

@code {

    [Parameter] public RenderFragment ChildContent { get; set; }

    [Parameter] public string Trigger { get; set; } = MenuTrigger.OnClick;

    [Parameter, EditorRequired] public string? MenuId { get; set; }

    [Parameter] public string TargetId { get; set; } = Guid.NewGuid().ToString();

    [Parameter] public string Placement { get; set; } = MenuPlacement.Bottom;

    [Parameter] public double Margin { get; set; } = 5;

    [Parameter] public object? MenuData { get; set; }

    [Parameter] public bool DisableMenuTarget { get; set; }
    private bool _disableMenuTarget;

    private ElementReference _menuTarget;
    private DotNetObjectReference<SheetMenuTarget>? _dotnetRef;
    private IJSObjectReference? _menuTargetService;
    private Task<IJSObjectReference?>? _menuTargetServiceTask;
    private bool _isDisposed;
    private bool _contextListenerAttached;

    private bool ShouldListenForContextMenu =>
        !_disableMenuTarget && !_isDisposed && Trigger == MenuTrigger.OnContextMenu;


    protected override async Task OnParametersSetAsync()
    {
        _disableMenuTarget = DisableMenuTarget;
        // Only detach here: the target element is not bound until after the first render.
        if (!ShouldListenForContextMenu && _contextListenerAttached)
        {
            _contextListenerAttached = false;
            if (_menuTargetService != null)
                await _menuTargetService.InvokeVoidAsync("removeContextListener");
        }

        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ShouldListenForContextMenu || _contextListenerAttached)
            return;

        // Renders can overlap while the service is created; they share one creation rather than
        // each attaching its own listener.
        var menuTargetService = await (_menuTargetServiceTask ??= CreateMenuTargetServiceAsync());
        if (menuTargetService == null || !ShouldListenForContextMenu || _contextListenerAttached)
            return;

        // Marked before the call so a render arriving during it does not attach again, and a
        // disable arriving during it sends a remove that runs after this set.
        _contextListenerAttached = true;
        await menuTargetService.InvokeVoidAsync("setContextListener", _menuTarget, nameof(TargetOnContextMenu));
    }

    private async Task<IJSObjectReference?> CreateMenuTargetServiceAsync()
    {
        var module =
            await _js.InvokeAsync<IJSObjectReference>("import",
                "./_content/BlazorDatasheet/js/menu-target.js");

        if (_isDisposed)
        {
            await DisposeJsObjectReferenceAsync(module);
            return null;
        }

        var dotnetRef = DotNetObjectReference.Create(this);

        try
        {
            var menuTargetService = await module.InvokeAsync<IJSObjectReference>(
                "getMenuTargetService", dotnetRef);

            if (_isDisposed)
            {
                await SafeDisposeMenuTargetServiceAsync(menuTargetService);
                return null;
            }

            _menuTargetService = menuTargetService;
            _dotnetRef = dotnetRef;
            dotnetRef = null;
            return menuTargetService;
        }
        finally
        {
            dotnetRef?.Dispose();
            await DisposeJsObjectReferenceAsync(module);
        }
    }

    private async Task TargetOnClick(MouseEventArgs obj)
    {
        if (Trigger != MenuTrigger.OnClick)
            return;

        await ShowMenu(MenuTrigger.OnClick, obj);
    }

    private async Task TargetOnMouseDown(MouseEventArgs obj)
    {
        if (Trigger != MenuTrigger.OnPress)
            return;

        await ShowMenu(MenuTrigger.OnPress, obj);
    }

    [JSInvokable(nameof(TargetOnContextMenu))]
    public async Task TargetOnContextMenu(MouseEventArgs obj)
    {
        if (Trigger != MenuTrigger.OnContextMenu)
            return;

        await ShowMenu(MenuTrigger.OnContextMenu, obj);
    }

    private async Task TargetOnHover(MouseEventArgs obj)
    {
        if (Trigger != MenuTrigger.OnHover)
            return;

        await ShowMenu(MenuTrigger.OnHover, obj);
    }

    private async Task ShowMenu(string trigger, MouseEventArgs args)
    {
        if (string.IsNullOrEmpty(MenuId))
            return;
        
        if(DisableMenuTarget)
            return;

        await MenuService.ShowMenuAsync(MenuId, new MenuTargetOptions(TargetId, Placement, Margin, trigger, args.ClientX, args.ClientY), MenuData);
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _contextListenerAttached = false;

        var menuTargetService = _menuTargetService;
        _menuTargetService = null;
        var dotnetRef = _dotnetRef;
        _dotnetRef = null;

        try
        {
            if (menuTargetService != null)
                await SafeDisposeMenuTargetServiceAsync(menuTargetService);
        }
        catch (Exception)
        {
            // Ignore
        }
        finally
        {
            dotnetRef?.Dispose();
        }
    }

    private static async Task SafeDisposeMenuTargetServiceAsync(IJSObjectReference menuTargetService)
    {
        try
        {
            await menuTargetService.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnects during server-side component teardown.
        }

        await DisposeJsObjectReferenceAsync(menuTargetService);
    }

}

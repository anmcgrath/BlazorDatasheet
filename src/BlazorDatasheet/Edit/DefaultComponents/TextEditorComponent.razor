@inherits BaseEditor
@using BlazorDatasheet.Core.Interfaces
@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Core.Edit
@using BlazorDatasheet.Core.FormulaEngine

<FormulaEditor
    @ref="_formulaEditor"
    Sheet="_sheet"
    Style="@Style"
    CellWidth="CellWidth"
    CellHeight="CellHeight"
    SoftEdit="_isSoftEdit"
    ReadyToFocus="_hasBegunEdit"
    IsDefaultInputOwner="true"
    Value="@CurrentValue"
    ValueChanged="OnInput"/>

@code {

    private Sheet? _sheet;
    private FormulaEditor _formulaEditor = default!;
    private bool _isSoftEdit;
    private bool _hasBegunEdit;
    public bool IsFormulaValue => FormulaEngine.IsFormula(CurrentValue);

    public override void BeforeEdit(IReadOnlyCell cell, Sheet sheet)
    {
        _sheet = sheet;
        _isSoftEdit = _sheet.Editor.IsSoftEdit;
        ResetAutoScrollActive();

        // References are picked from the sheet by the edit session, which writes them into the edit value.
        _sheet.Editor.FormulaEdit.IsPickingEnabled = true;
        StateHasChanged();
    }

    private void OnInput(string value)
    {
        CurrentValue = value ?? string.Empty;
    }

    public override void BeginEdit(EditEntryMode entryMode, string? editValue, string key)
    {
        _hasBegunEdit = true;
        if (entryMode == EditEntryMode.Key && !String.IsNullOrEmpty(key) && key.Length == 1)
        {
            CurrentValue = key;
        }
        else
        {
            CurrentValue = editValue ?? string.Empty;
        }

        StateHasChanged();
    }

    public override bool HandleKey(string key, bool ctrlKey, bool shiftKey, bool altKey, bool metaKey) =>
        _formulaEditor.HandleKey(key, ctrlKey, shiftKey, altKey, metaKey);

    public async Task FocusAsync() => await _formulaEditor.FocusAsync();

}

@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Formula.Core

@{
    var definitions = Function.ParameterDefinitions;
    var currentParam = GetCurrentParameter();
}

<div class="bds-func-hint-signature">
    <span style="font-weight: @(ArgIndex == -1 ? "bold" : "normal")">@FunctionName.ToUpper()</span>
    <span>(</span>

    @for (var i = 0; i < definitions.Length; i++)
    {
        var paramDefinition = definitions[i];
        <span style="font-weight: @(i == ArgIndex ? "bold" : "normal")">@paramDefinition.Name</span>
        @if (i < definitions.Length - 1)
        {
            <span>, </span>
        }
    }
    @if (definitions.Length > 0 && definitions.Last().IsRepeating)
    {
        <span>,</span>
        <span
            style="font-weight: @(ArgIndex >= definitions.Length ? "bold" : "normal")">[@definitions.Last().Name...]</span>
    }
    <span>)</span>
</div>

@if (!string.IsNullOrWhiteSpace(Function.Description))
{
    <div class="bds-func-hint-description">@Function.Description</div>
}

@if (currentParam != null && !string.IsNullOrWhiteSpace(currentParam.Description))
{
    <div class="bds-func-hint-param">
        <div class="bds-func-hint-param-name">
            @currentParam.Name
            @if (currentParam.Requirement == ParameterRequirement.Optional)
            {
                <span class="bds-func-hint-param-optional">(optional)</span>
            }
        </div>
        <div class="bds-func-hint-param-description">@currentParam.Description</div>
    </div>
}

@code{

    [Parameter] public required string FunctionName { get; set; }

    [Parameter] public required FunctionDescriptor Function { get; set; }

    [Parameter] public required int ArgIndex { get; set; }

    /// <summary>
    /// The parameter that the caret is in. Arguments past the end belong to the last parameter when it repeats.
    /// </summary>
    private ParameterDefinition? GetCurrentParameter()
    {
        var definitions = Function.ParameterDefinitions;
        if (ArgIndex < 0 || definitions.Length == 0)
            return null;

        if (ArgIndex < definitions.Length)
            return definitions[ArgIndex];

        return definitions[^1].IsRepeating ? definitions[^1] : null;
    }

}

@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Core.Events.Layout
@using BlazorDatasheet.Core.Events.Visual
@using BlazorDatasheet.Core.Layout
@using BlazorDatasheet.DataStructures.Geometry
@using BlazorDatasheet.Render
@using BlazorDatasheet.Render.Layers
@using BlazorDatasheet.Render.Layers.Preview
@using BlazorDatasheet.Services
@using BlazorDatasheet.Virtualise

@implements IAsyncDisposable

@if (PaneContext.Sheet.HasVisibleCells(ViewRegion))
{
    <LayerContainer
        Sheet="PaneContext.Sheet"
        ViewRegion="@ViewRegion"
        PointerInputService="PaneContext.PointerInputService"
        PreviewService="PaneContext.PreviewService">
        <HighlightLayer/>
        @if (PaneContext.UseAutoFill && !PaneContext.IsReadOnly)
        {
            <AutofillLayer/>
        }
        @if (RenderAutofitLayer)
        {
            <AutofitLayer
                @ref="_autofitLayer"
                AutoFitOnInteraction="PaneContext.AutoFit"
                NumberOfSignificantDigits="PaneContext.NumberPrecisionDisplay"
                CellRenderFragment="PaneContext.CellRenderFragment"/>
        }
        <VirtualMergesLayer
            CellRenderFragment="PaneContext.CellRenderFragment"
            NumberPrecisionDisplay="PaneContext.NumberPrecisionDisplay"
            Cache="_visualCellCache"/>

        <EditorLayer Disabled="@PaneContext.IsReadOnly" @ref="_editorLayer"
                     CustomCellTypes="@PaneContext.CustomCellTypeDefinitions"/>

        <SelectionRendererLayer/>
        <PreviewLayer/>
        @if (PaneContext.ShowFormulaDependents)
        {
            <FormulaDependenciesLayer/>
        }
    </LayerContainer>

    <Virtualise2D
        OverscanColumns="OverscanColumns"
        OverscanRows="OverscanRows"
        OnViewportChanged="HandleVirtualViewportChanged"
        LayoutProvider="_cellLayoutProvider"
        ViewRegion="ViewRegion"
        RowClass="bds-row"
        @ref="_mainView"
        Context="vr">
        <RowTemplate>
            <DatasheetGridRow
                NumberPrecisionDisplay="PaneContext.NumberPrecisionDisplay"
                Row="vr.Row"
                CellRenderFragment="PaneContext.CellRenderFragment"
                VisibleColIndices="vr.VisibleColIndices"
                Sheet="PaneContext.Sheet"
                Cache="_visualCellCache"
                IsDirty="IsRowDirty(vr.Row)"/>
        </RowTemplate>
    </Virtualise2D>
}

@code {

    [CascadingParameter] private PaneContext PaneContext { get; set; } = null!;

    private Sheet? _sheet;

    /// <summary>
    /// The the view that this pane will handle
    /// </summary>
    [Parameter, EditorRequired]
    public required IRegion ViewRegion { get; set; } = null!;

    private IGridLayoutProvider _cellLayoutProvider = null!;

    [Parameter] public int OverscanColumns { get; set; } = 2;
    [Parameter] public int OverscanRows { get; set; } = 6;
    [Parameter] public bool RenderAutofitLayer { get; set; }
    [Parameter] public Action<EditorLayer?, bool>? EditorLayerChanged { get; set; }
    [Parameter] public Action<AutofitLayer?>? AutofitLayerChanged { get; set; }

    private Virtualise2D? _mainView;
    private EditorLayer? _editorLayer;
    private AutofitLayer? _autofitLayer;
    private EditorLayer? _registeredEditorLayer;
    private AutofitLayer? _registeredAutofitLayer;


    private readonly HashSet<int> _dirtyRowIndices = new();
    private bool _forceRender;
    private Dictionary<CellPosition, VisualCell> _visualCellCache = new();

    // reused across resize events so that dragging a border doesn't allocate on every pointer move.
    private readonly Dictionary<int, AxisMetrics> _rowMetrics = new();
    private readonly Dictionary<int, AxisMetrics> _colMetrics = new();
    private IRegion? _currentViewPortRegion;
    private IRegion? _lastViewRegion;
    private PaneContext? _lastPaneContext;


    protected override void OnParametersSet()
    {
        var sheet = PaneContext.Sheet;
        var paneContextChanged = _lastPaneContext != null && !ReferenceEquals(_lastPaneContext, PaneContext);
        _lastPaneContext = PaneContext;

        if (_sheet == null || _sheet != sheet)
        {
            RemoveSheetEvents();

            _sheet = sheet;

            _cellLayoutProvider = new CellLayoutProvider(sheet, ViewRegion);
            _visualCellCache.Clear();

            AddSheetEvents();

            _forceRender = true;
        }

        if (paneContextChanged)
            InvalidateVisibleCells();

        if (_lastViewRegion == null || !_lastViewRegion.Equals(ViewRegion))
        {
            _lastViewRegion = ViewRegion;
            _cellLayoutProvider.ViewRegion = ViewRegion;
            _forceRender = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // the layers live inside the "has visible cells" branch, so a pane that starts empty only
        // gets its refs once cells appear - register on the transition, not just on first render.
        if (!ReferenceEquals(_registeredEditorLayer, _editorLayer))
        {
            if (_registeredEditorLayer != null)
                EditorLayerChanged?.Invoke(_registeredEditorLayer, false);

            _registeredEditorLayer = _editorLayer;

            if (_editorLayer != null)
                EditorLayerChanged?.Invoke(_editorLayer, true);
        }

        if (_autofitLayer != null && !ReferenceEquals(_registeredAutofitLayer, _autofitLayer))
        {
            _registeredAutofitLayer = _autofitLayer;
            AutofitLayerChanged?.Invoke(_autofitLayer);
        }

        ClearDirty();

        base.OnAfterRender(firstRender);
    }

    private void ClearDirty()
    {
        _dirtyRowIndices.Clear();
        _forceRender = false;
    }

    private void HandleVirtualViewportChanged(VirtualViewportChangedEventArgs args)
    {
        _currentViewPortRegion = args.Viewport.ViewRegion;
        foreach (var region in args.RemovedRegions)
        {
            foreach (var position in region)
            {
                _visualCellCache.Remove(position);
            }
        }

        MakeRegionsDirty(args.NewRegions);
    }

    private void SheetOnSheetDirty(object? sender, DirtySheetEventArgs e)
    {
        if (e.IsEmpty)
            return;
        
        var dirtyRegions = new List<IRegion>();
        foreach (var (interval, _) in e.DirtyRows.GetAllIntervalData())
            dirtyRegions.Add(new Region(interval.Start, interval.End, e.DirtyColStart, e.DirtyColEnd));

        if (dirtyRegions.Count > 0)
            MakeRegionsDirty(dirtyRegions);
    }


    private void MakeRegionsDirty(IEnumerable<IRegion?> dirtyRegions)
    {
        if (_sheet == null)
            return;

        foreach (var region in dirtyRegions)
        {
            var boundedRegion = region?.GetIntersection(_currentViewPortRegion ?? ViewRegion) as Region;
            if (boundedRegion == null)
                continue;

            var visibleCols = new List<int>();
            foreach (var col in _sheet.Columns.GetVisibleIndices(boundedRegion.Left, boundedRegion.Right))
                visibleCols.Add(col);

            if (visibleCols.Count == 0)
                continue;

            // width and visibility are the same for every cell in a column, so resolve them once
            // for the region rather than once per cell.
            var colMetrics = new AxisMetrics[visibleCols.Count];
            for (var i = 0; i < visibleCols.Count; i++)
                colMetrics[i] = AxisMetrics.ForColumn(_sheet, visibleCols[i]);

            foreach (var row in _sheet.Rows.GetVisibleIndices(boundedRegion.Top, boundedRegion.Bottom))
            {
                _dirtyRowIndices.Add(row);
                var rowMetrics = AxisMetrics.ForRow(_sheet, row);

                for (var i = 0; i < visibleCols.Count; i++)
                {
                    var col = visibleCols[i];
                    var position = new CellPosition(row, col);
                    var visualCell = new VisualCell(row, col, _sheet, PaneContext.NumberPrecisionDisplay,
                        rowMetrics, colMetrics[i]);

                    if (!_visualCellCache.TryAdd(position, visualCell))
                        _visualCellCache[position] = visualCell;
                }
            }
        }

        StateHasChanged();
    }

    private bool IsRowDirty(int rowIndex)
    {
        return _dirtyRowIndices.Contains(rowIndex);
    }

    private void AddSheetEvents()
    {
        if (_sheet == null)
            return;

        _sheet.SheetDirty += SheetOnSheetDirty;
        _sheet.Columns.SizeModified += HandleSizeModified;
        _sheet.Rows.SizeModified += HandleSizeModified;
    }

    private void RemoveSheetEvents()
    {
        if (_sheet == null)
            return;

        _sheet.SheetDirty -= SheetOnSheetDirty;
        _sheet.Columns.SizeModified -= HandleSizeModified;
        _sheet.Rows.SizeModified -= HandleSizeModified;
    }

    private void HandleSizeModified(object? sender, SizeModifiedEventArgs e)
    {
        if (_sheet == null)
        {
            InvalidateVisibleCells();
            StateHasChanged();
            return;
        }

        // Resizing (or hiding) a row or column only changes cell sizes and visibility - values,
        // formats and merges are untouched. Dragging a border fires this on every pointer move, so
        // the cached cells are patched in place rather than thrown away and rebuilt.
        PatchCachedCellSizes(e);

        _forceRender = true;
        StateHasChanged();
    }

    private void PatchCachedCellSizes(SizeModifiedEventArgs e)
    {
        if (_visualCellCache.Count == 0)
            return;

        _rowMetrics.Clear();
        _colMetrics.Clear();

        foreach (var visualCell in _visualCellCache.Values)
        {
            if (!IsAffectedBySizeChange(visualCell, e))
                continue;

            visualCell.RefreshAxisMetrics(_sheet!, GetRowMetrics(visualCell.Row), GetColMetrics(visualCell.Col));
        }
    }

    /// <summary>
    /// A resize only changes the size of the rows/columns it covers, so cells outside it keep the
    /// size they already have. Merged cells count when the merge overlaps the resized range.
    /// </summary>
    private static bool IsAffectedBySizeChange(VisualCell cell, SizeModifiedEventArgs e)
    {
        if (e.Axis == Axis.Col)
        {
            return cell.Merge == null
                ? cell.Col >= e.IndexStart && cell.Col <= e.IndexEnd
                : cell.Merge.Left <= e.IndexEnd && cell.Merge.Right >= e.IndexStart;
        }

        return cell.Merge == null
            ? cell.Row >= e.IndexStart && cell.Row <= e.IndexEnd
            : cell.Merge.Top <= e.IndexEnd && cell.Merge.Bottom >= e.IndexStart;
    }

    private AxisMetrics GetRowMetrics(int row)
    {
        if (!_rowMetrics.TryGetValue(row, out var metrics))
            _rowMetrics[row] = metrics = AxisMetrics.ForRow(_sheet!, row);

        return metrics;
    }

    private AxisMetrics GetColMetrics(int col)
    {
        if (!_colMetrics.TryGetValue(col, out var metrics))
            _colMetrics[col] = metrics = AxisMetrics.ForColumn(_sheet!, col);

        return metrics;
    }

    private void InvalidateVisibleCells()
    {
        _visualCellCache.Clear();
        _forceRender = true;

        if (_sheet == null || _currentViewPortRegion == null)
            return;

        foreach (var row in _sheet.Rows.GetVisibleIndices(
                     _currentViewPortRegion.Top,
                     _currentViewPortRegion.Bottom))
        {
            _dirtyRowIndices.Add(row);
        }
    }

    public async Task RefreshView()
    {
        if (_mainView != null)
            await _mainView.RefreshView();
    }

    public async ValueTask DisposeAsync()
    {
        EditorLayerChanged?.Invoke(_registeredEditorLayer ?? _editorLayer, false);
        _registeredEditorLayer = null;
        RemoveSheetEvents();
        _editorLayer?.Dispose();
        if (_mainView != null) await _mainView.DisposeAsync();
        if (_autofitLayer != null) await ((IAsyncDisposable)_autofitLayer).DisposeAsync();
    }

    protected override bool ShouldRender()
    {
        return _forceRender || _dirtyRowIndices.Any();
    }

}

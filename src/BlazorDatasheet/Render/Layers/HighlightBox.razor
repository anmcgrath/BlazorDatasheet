@using System.Globalization
@using BlazorDatasheet.Core.Edit
@using BlazorDatasheet.DataStructures.Geometry

<BoxOverlayRenderer
    Width="Width"
    Height="Height"
    X="X"
    Y="Y"
    ZIndex="12"
    BorderStyle="solid"
    BorderColor="@Color"
    BorderThickness="var(--selection-border-thickness)"
    ShowBorderLeft="ShowLeft"
    ShowBorderRight="ShowRight"
    ShowBorderTop="ShowTop"
    ShowBorderBottom="ShowBottom"/>

<RegionDragHandles Region="Region" VisibleRegion="VisibleRegion" X="X" Y="Y" Width="Width" Height="Height"
                   Color="Color" CanDrag="CanDrag" IsDragging="IsDragging" DragStarted="DragStarted"/>

@code {

    /// <summary>
    /// The region that the reference is to, inside the sheet.
    /// </summary>
    [Parameter, EditorRequired]
    public IRegion Region { get; set; } = null!;

    /// <summary>
    /// The part of <see cref="Region"/> that is shown, which is less than all of it when the layer ends part way through.
    /// </summary>
    [Parameter, EditorRequired]
    public IRegion VisibleRegion { get; set; } = null!;

    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public double Width { get; set; }
    [Parameter] public double Height { get; set; }
    [Parameter] public string Color { get; set; } = string.Empty;

    /// <summary>
    /// Whether the reference can be moved and resized with the pointer.
    /// </summary>
    [Parameter]
    public bool CanDrag { get; set; }

    /// <summary>
    /// Whether a reference is being dragged, during which the pointer belongs to the cells that it is dragged over.
    /// </summary>
    [Parameter]
    public bool IsDragging { get; set; }

    [Parameter] public EventCallback<HighlightBoxDrag> DragStarted { get; set; }

    // an edge that the layer cuts off isn't an edge of the reference
    private bool ShowLeft => VisibleRegion.Left == Region.Left;
    private bool ShowRight => VisibleRegion.Right == Region.Right;
    private bool ShowTop => VisibleRegion.Top == Region.Top;
    private bool ShowBottom => VisibleRegion.Bottom == Region.Bottom;

}

@using System.Text
@using BlazorDatasheet.Core.Commands.Data
@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Core.Events
@using BlazorDatasheet.Core.Layout
@using BlazorDatasheet.DataStructures.Geometry
@using BlazorDatasheet.Render
@using BlazorDatasheet.Render.Layers.Preview
@using Microsoft.JSInterop
@using static BlazorDatasheet.Util.JsInteropHelper
@inherits Layer
@implements IAsyncDisposable
@inject IJSRuntime Js;

<!--
    Sits at the layer origin and stays rendered for the lifetime of the layer, so that a drag can keep
    measuring against it after the dragger below has been virtualised away.
-->
<div @ref="_originElement"
     style="position:absolute;top:0;left:0;width:0;height:0;pointer-events:none;"></div>

@if (!Sheet.Editor.IsEditing && Sheet.Selection.ActiveRegion != null && ViewRegion?.Contains(Sheet.Selection.ActiveRegion.BottomRight) == true)
{
    <!-- render dragger (bottom right corner) -->
    <div id="auto-filler"
         class="bds-unselectable auto-fill"
         @onpointerdown="DraggerMouseDown"
         @onpointerup="DraggerMouseUp"
         style="@GetDraggerStyleString();cursor:crosshair;pointer-events: all;">
    </div>
}


@code {
    [CascadingParameter] private PaneContext PaneContext { get; set; } = null!;

    [CascadingParameter] private PreviewService? PreviewService { get; set; }

    private PreviewItem? _previewItem;
    private bool _isDragging;

    private IRegion? _dragPreviewRegion;
    private CellLayoutProvider _cellLayoutProvider = new(new Sheet(0, 0));
    private IJSObjectReference? _module;
    private IJSObjectReference? _dragTracker;
    private DotNetObjectReference<AutofillLayer>? _dotNetRef;
    private ElementReference _originElement;

    protected override void OnSheetChange(Sheet newSheet, Sheet oldSheet)
    {
        oldSheet.Selection.SelectionChanged -= OnSelectionChanged;
        newSheet.Selection.SelectionChanged += OnSelectionChanged;
        _cellLayoutProvider = new CellLayoutProvider(newSheet);
    }

    private void OnSelectionChanged(object? sender, SelectionChangedEventArgs args)
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isDisposed)
            return;

        var module = await Js.InvokeAsync<IJSObjectReference>("import",
            "./_content/BlazorDatasheet/Render/Layers/AutofillLayer.razor.js");

        // disposal can complete while the import is in flight, which would leak the module
        if (_isDisposed)
        {
            await DisposeJsObjectReferenceAsync(module);
            return;
        }

        var dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            var dragTracker = await module.InvokeAsync<IJSObjectReference>("createDragTracker");

            if (_isDisposed)
            {
                await DisposeJsObjectReferenceAsync(dragTracker);
                await DisposeJsObjectReferenceAsync(module);
                return;
            }

            _module = module;
            _dragTracker = dragTracker;
            _dotNetRef = dotNetRef;
            dotNetRef = null;
        }
        finally
        {
            dotNetRef?.Dispose();
        }
    }

    /// <summary>
    /// Called by the JS drag tracker with the pointer position relative to the layer origin.
    /// </summary>
    [JSInvokable(nameof(HandleDragMove))]
    public Task HandleDragMove(Point2d layerPosition)
    {
        if (!_isDragging)
            return Task.CompletedTask;

        UpdateDragPreview(layerPosition);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable(nameof(HandleDragEnd))]
    public async Task HandleDragEnd()
    {
        if (!_isDragging)
            return;

        if (_dragPreviewRegion != null && Sheet.Selection.ActiveRegion != null)
            Sheet.Commands.ExecuteCommand(new AutoFillCommand(Sheet.Selection.ActiveRegion, _dragPreviewRegion.Clone()));

        RemovePreviewItem();
        _dragPreviewRegion = null;
        await SetDraggingAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateDragPreview(Point2d layerPosition)
    {
        if (Sheet.Selection.ActiveRegion == null)
            return;

        // Left and Top are the layer origin in sheet coordinates, and don't move as the sheet
        // scrolls, so converting here gives a position independent of the scroll offset.
        var sheetX = layerPosition.X + Left;
        var sheetY = layerPosition.Y + Top;

        if (!AutofillDragCalculator.TryCalculatePreviewRegion(Sheet, Sheet.Selection.ActiveRegion,
                _cellLayoutProvider, sheetX, sheetY, out var previewRegion))
            return;

        _dragPreviewRegion = previewRegion;
        UpdatePreviewItem();
    }

    private void UpdatePreviewItem()
    {
        if (PreviewService == null || _dragPreviewRegion == null)
            return;

        var newItem = new PreviewItem
        {
            Coord = new RegionCoord(_dragPreviewRegion),
            BorderStyle = "dashed",
            BorderThickness = "var(--selection-border-thickness)",
            BackgroundVisible = false
        };
        PreviewService.Update(_previewItem, newItem);
        _previewItem = newItem;
    }

    private void RemovePreviewItem()
    {
        if (_previewItem != null && PreviewService != null)
        {
            PreviewService.Remove(_previewItem);
            _previewItem = null;
        }
    }

    private async Task DraggerMouseDown(PointerEventArgs e)
    {
        if (Sheet.Selection.ActiveRegion == null)
            return;

        _dragPreviewRegion = null;
        await SetDraggingAsync(true);
    }

    private async Task DraggerMouseUp(PointerEventArgs obj)
    {
        // if the user mouses up on the dragger (which doesn't move)
        // then we should just cancel out of the drag
        RemovePreviewItem();
        _dragPreviewRegion = null;
        await SetDraggingAsync(false);
        StateHasChanged();
    }

    private async Task SetDraggingAsync(bool isDragging)
    {
        if (_isDragging == isDragging)
            return;

        _isDragging = isDragging;

        PaneContext.AutoScrollState.SetAutofillDragging(isDragging);

        if (isDragging)
            await StartTrackingAsync();
        else
            await StopTrackingAsync();
    }

    private async Task StartTrackingAsync()
    {
        if (_dragTracker == null || _dotNetRef == null || _isDisposed)
            return;

        try
        {
            await _dragTracker.InvokeVoidAsync("start", _originElement, _dotNetRef,
                nameof(HandleDragMove), nameof(HandleDragEnd));
        }
        catch (JSDisconnectedException)
        {
            // circuit torn down mid-drag
        }
    }

    private async Task StopTrackingAsync()
    {
        if (_dragTracker == null)
            return;

        try
        {
            await _dragTracker.InvokeVoidAsync("stop");
        }
        catch (JSDisconnectedException)
        {
            // circuit torn down mid-drag
        }
    }

    private string GetDraggerStyleString()
    {
        var region = Sheet.Region.GetIntersection(Sheet.Selection.ActiveRegion ?? Sheet.Selection.SelectingRegion);
        if (region == null)
            return "display:none;";

        var x = GetLayerColumnX(region.Right + 1);
        var y = GetLayerRowY(region.Bottom + 1);

        var w = 8d;
        var h = 8d;
        var sb = new StringBuilder();
        sb.Append("display:block;position:absolute;");
        sb.Append($"left:{x - w / 2}px; top:{y - w / 2}px;");
        sb.Append($"width:{w}px;height:{h}px;");
        sb.Append("background:var(--selection-border-color);");
        sb.Append("border:1px solid var(--sheet-bg-color);");
        return sb.ToString();
    }

    private bool _isDisposed;

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        RemovePreviewItem();
        Sheet.Selection.SelectionChanged -= OnSelectionChanged;

        await SetDraggingAsync(false);

        var dragTracker = _dragTracker;
        _dragTracker = null;
        var module = _module;
        _module = null;
        var dotNetRef = _dotNetRef;
        _dotNetRef = null;

        try
        {
            if (dragTracker != null)
            {
                try
                {
                    await dragTracker.InvokeVoidAsync("dispose");
                }
                catch (JSDisconnectedException)
                {
                    // Ignore disconnects during server-side component teardown.
                }

                await DisposeJsObjectReferenceAsync(dragTracker);
            }

            if (module != null)
                await module.DisposeAsync();
        }
        catch
        {
            // ignored
        }
        finally
        {
            dotNetRef?.Dispose();
        }
    }

}

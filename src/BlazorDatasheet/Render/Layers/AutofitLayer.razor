@using System.Globalization
@using BlazorDatasheet.Core.Commands
@using BlazorDatasheet.Core.Commands.Formatting
@using BlazorDatasheet.Core.Commands.RowCols
@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Core.Events.Commands
@using BlazorDatasheet.Core.Events.Edit
@using BlazorDatasheet.Core.Formats
@using BlazorDatasheet.DataStructures.Geometry
@using BlazorDatasheet.Util
@using Microsoft.JSInterop
@using ICommand = BlazorDatasheet.Core.Commands.ICommand
@inherits Layer
@implements IAsyncDisposable
@inject IJSRuntime Js


<div @ref="_autoFitEl">
    @foreach (var cell in _currentCells)
    {
        <div @key="cell"
             class="bds-autoFit"
             data-row="@cell.Row"
             data-col="@cell.Col"
             data-axis-index="@GetAxisIndex(cell)"
             data-axis-size="@FormatNumber(GetAxisSize(cell))"
             data-cell-size="@FormatNumber(GetCellSize(cell))">
            <div style="@GetStyle(cell)">
                @CellRenderFragment(cell)
            </div>
        </div>
    }
</div>


@code {

    internal const int BatchSize = 200;
    private const double SizeComparisonTolerance = 1e-6;

    [Parameter, EditorRequired] public required RenderFragment<VisualCell> CellRenderFragment { get; set; }

    /// <summary>
    /// Whether to perform the auto-fit when the user finishes editing or when a cell is formatted.
    /// </summary>
    [Parameter, EditorRequired]
    public required bool AutoFitOnInteraction { get; set; }

    [Parameter, EditorRequired] public required int NumberOfSignificantDigits { get; set; }

    private readonly Queue<AutofitRequest> _pendingRequests = new();
    private readonly CancellationTokenSource _disposeCancellationTokenSource = new();

    private ElementReference _autoFitEl = default!;
    private List<VisualCell> _currentCells = new();
    private AutofitOperation? _activeOperation;
    private IJSObjectReference? _module;
    private bool _isMeasuring;
    private bool _renderCleanupPending;
    private bool _disposed;

    protected override void OnSheetChange(Sheet newSheet, Sheet oldSheet)
    {
        oldSheet.Editor.EditAccepted -= EditorOnEditFinished;
        newSheet.Editor.EditAccepted += EditorOnEditFinished;
        oldSheet.Commands.CommandRun -= CommandsOnCommandRun;
        newSheet.Commands.CommandRun += CommandsOnCommandRun;

        AbortOperations();
    }

    private void CommandsOnCommandRun(object? sender, CommandRunEventArgs e)
    {
        if (!AutoFitOnInteraction)
            return;

        if (e.Command is SetFormatCommand cmd && cmd.Region.IsSingleCell())
            _ = QueueInteractionAutofitAsync(cmd);
    }

    private async Task QueueInteractionAutofitAsync(SetFormatCommand command)
    {
        // Let CommandManager finish executing the triggering command before attaching the
        // asynchronously measured resize command to it.
        await Task.Yield();

        if (_disposed)
            return;

        await InvokeAsync(() =>
            AutoFit(command.Region, Axis.Row, AutofitMethod.ExpandOnly, command));
    }

    private void EditorOnEditFinished(object? sender, EditAcceptedEventArgs e)
    {
        if (!AutoFitOnInteraction)
            return;

        var cell = Sheet.Cells.GetCell(e.Row, e.Col);
        var wrapped = cell.Format.TextWrap == TextWrapping.Wrap;
        AutoFit(new Region(cell.Row, cell.Col), wrapped ? Axis.Row : Axis.Col, AutofitMethod.ExpandOnly);
    }

    /// <summary>
    /// Auto-fits the given axis over <paramref name="region"/>.
    /// </summary>
    internal void AutoFit(IRegion region, Axis axis, AutofitMethod method,
        IUndoableCommand? triggeringCommand = null)
    {
        if (axis == Axis.None)
            return;

        QueueRequests(region, [axis], method, triggeringCommand);
    }

    /// <summary>
    /// Auto-fits both the column and row axes over <paramref name="region"/>. Columns are fitted
    /// first so that row heights are measured against the final column widths, and both resizes
    /// are undone by a single undo.
    /// </summary>
    internal void AutoFit(IRegion region, AutofitMethod method,
        IUndoableCommand? triggeringCommand = null)
        => QueueRequests(region, [Axis.Col, Axis.Row], method, triggeringCommand);

    private void QueueRequests(IRegion region, ReadOnlySpan<Axis> axes, AutofitMethod method,
        IUndoableCommand? triggeringCommand)
    {
        if (_disposed)
            return;

        var boundRegion = region.GetIntersection(Sheet.Region);
        if (boundRegion == null)
            return;

        // All requests queued together resize as one unit, so that a multi-axis auto-fit is a
        // single undo step.
        var chain = new AutofitChain(Sheet, triggeringCommand, axes.Length);
        foreach (var axis in axes)
            _pendingRequests.Enqueue(new AutofitRequest(boundRegion.Clone(), axis, method, chain));

        StartNextOperation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
            return;

        if (_module == null)
        {
            try
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import",
                    _disposeCancellationTokenSource.Token,
                    "./_content/BlazorDatasheet/Render/Layers/AutofitLayer.razor.js");
            }
            catch (OperationCanceledException) when (_disposed)
            {
                return;
            }
        }

        if (_renderCleanupPending && _currentCells.Count == 0)
            _renderCleanupPending = false;

        var operation = _activeOperation;
        if (operation == null || _currentCells.Count == 0 || _isMeasuring)
            return;

        _isMeasuring = true;
        var shouldRender = false;

        try
        {
            var axis = operation.Request.Axis == Axis.Col ? "col" : "row";
            var changes = await _module.InvokeAsync<AutofitDimensionChange[]>(
                "measureAutofitChanges",
                _disposeCancellationTokenSource.Token,
                _autoFitEl,
                axis);

            await InvokeAsync(() =>
            {
                if (_disposed || !ReferenceEquals(operation, _activeOperation))
                    return;

                MergeChanges(operation, changes);

                if (operation.HasMoreCells && LoadNextBatch(operation))
                {
                    shouldRender = true;
                }
                else
                {
                    CompleteOperation(operation);
                    shouldRender = true;
                }
            });
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch
        {
            AbortOperations();
            shouldRender = true;
            throw;
        }
        finally
        {
            _isMeasuring = false;

            if (shouldRender && !_disposed)
                await InvokeAsync(StateHasChanged);
        }
    }

    private void StartNextOperation()
    {
        if (_disposed || _activeOperation != null)
            return;

        while (_pendingRequests.TryDequeue(out var request))
        {
            var operation = new AutofitOperation(request);
            _activeOperation = operation;

            if (LoadNextBatch(operation))
            {
                _ = InvokeAsync(StateHasChanged);
                return;
            }

            _activeOperation = null;
        }
    }

    private bool LoadNextBatch(AutofitOperation operation)
    {
        var positions = GetNextPositions(operation);
        _currentCells = positions
            .Select(position => new VisualCell(position.row, position.col, Sheet, NumberOfSignificantDigits))
            .ToList();
        return _currentCells.Count > 0;
    }

    private List<CellPosition> GetNextPositions(AutofitOperation operation)
    {
        var region = operation.Request.Region;
        var remainingPositions = Sheet.Range(new Region(
                operation.NextRow,
                operation.NextRow,
                operation.NextCol,
                region.Right))
            .GetNonEmptyPositions();

        if (operation.NextRow < region.Bottom)
        {
            remainingPositions = remainingPositions.Concat(Sheet.Range(new Region(
                    operation.NextRow + 1,
                    region.Bottom,
                    region.Left,
                    region.Right))
                .GetNonEmptyPositions());
        }

        var positionsWithLookahead = remainingPositions.Take(BatchSize + 1).ToList();
        operation.HasMoreCells = positionsWithLookahead.Count > BatchSize;

        if (operation.HasMoreCells)
        {
            var nextPosition = positionsWithLookahead[BatchSize];
            operation.NextRow = nextPosition.row;
            operation.NextCol = nextPosition.col;
            positionsWithLookahead.RemoveAt(BatchSize);
        }

        return positionsWithLookahead;
    }

    private static void MergeChanges(AutofitOperation operation,
        IEnumerable<AutofitDimensionChange> changes)
    {
        foreach (var change in changes)
        {
            if (!operation.Changes.TryGetValue(change.Index, out var aggregate))
            {
                operation.Changes.Add(change.Index, change);
                continue;
            }

            aggregate.ExpandTo = Max(aggregate.ExpandTo, change.ExpandTo);
            aggregate.ContractTo = Max(aggregate.ContractTo, change.ContractTo);
        }
    }

    private void CompleteOperation(AutofitOperation operation)
    {
        if (!ReferenceEquals(operation, _activeOperation))
            return;

        _activeOperation = null;
        _currentCells.Clear();
        _renderCleanupPending = true;

        var commands = new List<ICommand>();
        foreach (var change in operation.Changes.Values.OrderBy(change => change.Index))
        {
            double? targetSize = null;
            if (change.ExpandTo.HasValue &&
                operation.Request.Method is AutofitMethod.ExpandOnly or AutofitMethod.ExpandOrContract)
            {
                targetSize = change.ExpandTo;
            }
            else if (change.ContractTo.HasValue && operation.Request.Method == AutofitMethod.ExpandOrContract)
            {
                targetSize = change.ContractTo;
            }

            var currentSize = operation.Request.Axis == Axis.Col
                ? Sheet.Columns.GetPhysicalWidth(change.Index)
                : Sheet.Rows.GetPhysicalHeight(change.Index);

            if (targetSize.HasValue &&
                Math.Abs(targetSize.Value - currentSize) > SizeComparisonTolerance)
            {
                commands.Add(new SetSizeCommand(change.Index, change.Index, targetSize.Value,
                    operation.Request.Axis));
            }
        }

        var chain = operation.Request.Chain;
        if (chain.IsMultiAxis)
        {
            CompleteMultiAxisRequest(chain, commands);
        }
        else if (commands.Count > 0)
        {
            var commandGroup = new CommandGroup(commands);

            if (chain.TriggeringCommand == null)
            {
                Sheet.Commands.ExecuteCommand(commandGroup);
            }
            else if (Sheet.Commands.ExecuteCommand(commandGroup, false, false))
            {
                chain.TriggeringCommand.AttachAfter(commandGroup);
            }
        }

        StartNextOperation();
    }

    private void CompleteMultiAxisRequest(AutofitChain chain, List<ICommand> commands)
    {
        if (!chain.IsFinalRequest)
        {
            if (commands.Count > 0)
            {
                // Apply the column sizes only long enough for the row pass to measure against them.
                // The completed operation is recorded once both axes have been measured.
                var provisionalGroup = new CommandGroup(commands);
                if (Sheet.Commands.ExecuteCommand(provisionalGroup, false, false))
                    chain.AddProvisionalCommands(provisionalGroup, commands);
            }

            chain.CompleteRequest();
            return;
        }

        chain.AddCommands(commands);
        chain.CompleteRequest();
        chain.RollbackProvisionalCommands();

        if (chain.Commands.Count == 0)
            return;

        var commandGroup = new CommandGroup(chain.Commands);
        if (chain.TriggeringCommand == null)
        {
            Sheet.Commands.ExecuteCommand(commandGroup);
        }
        else if (Sheet.Commands.ExecuteCommand(commandGroup, false, false))
        {
            chain.TriggeringCommand.AttachAfter(commandGroup);
        }
    }

    private string GetStyle(VisualCell cell)
    {
        var operation = _activeOperation;
        if (operation == null)
            return string.Empty;

        var style = new StyleBuilder();
        if (operation.Request.Axis == Axis.Row)
            style.AddStyle("max-width", FormatNumber(cell.Width) + "px");
        else
            style.AddStyle("max-height", FormatNumber(cell.Height) + "px");
        return style.ToString();
    }

    private int GetAxisIndex(VisualCell cell)
        => _activeOperation?.Request.Axis == Axis.Col ? cell.Col : cell.Row;

    private double GetAxisSize(VisualCell cell)
        => _activeOperation?.Request.Axis == Axis.Col
            ? Sheet.Columns.GetPhysicalWidth(cell.Col)
            : Sheet.Rows.GetPhysicalHeight(cell.Row);

    private double GetCellSize(VisualCell cell)
        => _activeOperation?.Request.Axis == Axis.Col ? cell.Width : cell.Height;

    private static string FormatNumber(double value)
        => value.ToString(CultureInfo.InvariantCulture);

    private static double? Max(double? first, double? second)
    {
        if (!first.HasValue)
            return second;
        if (!second.HasValue)
            return first;
        return Math.Max(first.Value, second.Value);
    }

    private void AbortOperations()
    {
        var chains = _pendingRequests.Select(request => request.Chain).ToHashSet();
        if (_activeOperation != null)
            chains.Add(_activeOperation.Request.Chain);

        foreach (var chain in chains)
            chain.RollbackProvisionalCommands();

        _pendingRequests.Clear();
        _activeOperation = null;

        if (_currentCells.Count > 0)
            _renderCleanupPending = true;
        _currentCells.Clear();
    }

    protected override bool ShouldRender()
        => _module == null || _currentCells.Count > 0 || _renderCleanupPending;

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _disposeCancellationTokenSource.Cancel();
        AbortOperations();

        Sheet.Editor.EditAccepted -= EditorOnEditFinished;
        Sheet.Commands.CommandRun -= CommandsOnCommandRun;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _disposeCancellationTokenSource.Dispose();
    }

    private sealed record AutofitRequest(
        IRegion Region,
        Axis Axis,
        AutofitMethod Method,
        AutofitChain Chain);

    /// <summary>
    /// Shared by every request queued from one auto-fit call. Multi-axis calls apply their first
    /// axis provisionally, then execute all resize commands as one durable command when measurement
    /// is complete.
    /// </summary>
    private sealed class AutofitChain(
        Sheet sheet,
        IUndoableCommand? triggeringCommand,
        int requestCount)
    {
        private readonly Sheet _sheet = sheet;
        private readonly bool _isMultiAxis = requestCount > 1;
        private CommandGroup? _provisionalCommandGroup;
        private int _remainingRequests = requestCount;

        public IUndoableCommand? TriggeringCommand { get; } = triggeringCommand;
        public List<ICommand> Commands { get; } = new();
        public bool IsMultiAxis => _isMultiAxis;
        public bool IsFinalRequest => _remainingRequests == 1;

        public void AddProvisionalCommands(CommandGroup commandGroup, IEnumerable<ICommand> commands)
        {
            _provisionalCommandGroup = commandGroup;
            Commands.AddRange(commands);
        }

        public void AddCommands(IEnumerable<ICommand> commands) => Commands.AddRange(commands);

        public void CompleteRequest() => _remainingRequests--;

        public void RollbackProvisionalCommands()
        {
            _provisionalCommandGroup?.Undo(_sheet);
            _provisionalCommandGroup = null;
        }
    }

    private sealed class AutofitOperation
    {
        public AutofitOperation(AutofitRequest request)
        {
            Request = request;
            NextRow = request.Region.Top;
            NextCol = request.Region.Left;
        }

        public AutofitRequest Request { get; }
        public Dictionary<int, AutofitDimensionChange> Changes { get; } = new();
        public int NextRow { get; set; }
        public int NextCol { get; set; }
        public bool HasMoreCells { get; set; }
    }
}

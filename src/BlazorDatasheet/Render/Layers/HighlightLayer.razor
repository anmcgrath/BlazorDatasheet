@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.DataStructures.Geometry
@using BlazorDatasheet.Formula.Core
@inherits Layer
@implements IDisposable

<div class="highlight-layer">
    @foreach (var reference in _references)
    {
        // references to other sheets have nothing to show here
        if (reference.Region == null || !IsInThisSheet(reference))
            continue;

        var region = reference.Region;
        var r = region.GetIntersection(ViewRegion);
        if (r == null)
            continue;
        var x = GetLayerColumnX(r.Left);
        var y = GetLayerRowY(r.Top);
        var w = Sheet.Columns.GetVisualWidthBetween(r.Left, r.Right + 1);
        var h = Sheet.Rows.GetVisualHeightBetween(r.Top, r.Bottom + 1);
        @* keyed by the reference's position in the formula, which is how the edit session identifies it *@
        <BoxOverlayRenderer
            @key="reference.Index"
            Width="w"
            Height="h"
            X="x"
            Y="y"
            ZIndex="12"
            BorderStyle="solid"
            BorderColor="@($"var(--highlight-color-{reference.ColorIndex})")"
            BorderThickness="var(--selection-border-thickness)"
            ShowBorderLeft="r.Left == region.Left"
            ShowBorderRight="r.Right == region.Right"
            ShowBorderTop="r.Top == region.Top"
            ShowBorderBottom="r.Bottom == region.Bottom"/>
    }
</div>


@code {

    // The same references, with the same colours, that the editor highlights in the formula text.
    private IReadOnlyList<FormulaReferenceSpan> _references = Array.Empty<FormulaReferenceSpan>();

    /// <summary>
    /// The sheet that the references without a sheet name are to, which is the one being edited.
    /// </summary>
    private Sheet? _editSheet;

    private Workbook? _workbook;

    protected override void OnSheetChange(Sheet newSheet, Sheet oldSheet)
    {
        // the formula may be in any sheet of the workbook, with references to this one
        if (_workbook != null)
            _workbook.FormulaEditReferencesChanged -= OnReferencesChanged;

        _workbook = newSheet.Workbook;
        _workbook.FormulaEditReferencesChanged += OnReferencesChanged;
        ReadReferences();
    }

    private void ReadReferences()
    {
        var formulaEdit = _workbook?.ActiveFormulaEdit;
        _editSheet = formulaEdit?.Sheet;
        _references = formulaEdit?.References ?? Array.Empty<FormulaReferenceSpan>();
    }

    private bool IsInThisSheet(FormulaReferenceSpan reference) =>
        reference.SheetName == null ? ReferenceEquals(_editSheet, Sheet) : reference.SheetName == Sheet.Name;

    private void OnReferencesChanged(object? sender, EventArgs e)
    {
        ReadReferences();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_workbook != null)
            _workbook.FormulaEditReferencesChanged -= OnReferencesChanged;
    }

}

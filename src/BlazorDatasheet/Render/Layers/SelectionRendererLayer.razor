@using BlazorDatasheet.Core.Data
@using BlazorDatasheet.Core.Events
@using BlazorDatasheet.Core.Events.Data
@using BlazorDatasheet.DataStructures.Geometry
@using BlazorDatasheet.Services
@using BlazorDatasheet.Render
@using BlazorDatasheet.Core.Layout
@inherits Layer
@implements IDisposable

@if (!ShowWhenNotCurrentSheet && !DatasheetRegistry.For(Sheet.Workbook).ShowsSelection(Sheet))
{
    return;
}

<div class="bds-selection-layer">
    @foreach (var region in Sheet.Selection.Regions)
    {
        var boundedRegion = region.GetIntersection(ViewRegion);
        var isActiveRegion = region.Equals(Sheet.Selection.ActiveRegion);
        if (boundedRegion == null)
            continue;
        <!-- if it's the active region, render around the active position -->
        if (isActiveRegion)
        {
            var inputRegion = Sheet.Cells.GetMerge(Sheet.Selection.ActiveCellPosition.row, Sheet.Selection.ActiveCellPosition.col) ??
                              new Region(Sheet.Selection.ActiveCellPosition.row, Sheet.Selection.ActiveCellPosition.col);

            var brokenRegions = boundedRegion
                .Break(inputRegion);

            foreach (var brokenRegion in brokenRegions)
            {
                <BoxOverlayRenderer
                    BackgroundVisible="true"
                    BorderThickness="0px"
                    X="GetLayerColumnX(brokenRegion.Left)"
                    Y="GetLayerRowY(brokenRegion.Top)"
                    Width="Sheet.Columns.GetVisualWidthBetween(brokenRegion.Left, brokenRegion.Right + 1)"
                    Height="Sheet.Rows.GetVisualHeightBetween(brokenRegion.Top, brokenRegion.Bottom + 1)"/>
            }
        }

        @if (isActiveRegion && PaneContext?.SelectionMove?.CanBegin == true)
        {
            <RegionDragHandles Region="@(region.GetIntersection(Sheet.Region)!)" VisibleRegion="boundedRegion"
                               X="GetLayerColumnX(boundedRegion.Left)" Y="GetLayerRowY(boundedRegion.Top)"
                               Width="Sheet.Columns.GetVisualWidthBetween(boundedRegion.Left, boundedRegion.Right + 1)"
                               Height="Sheet.Rows.GetVisualHeightBetween(boundedRegion.Top, boundedRegion.Bottom + 1)"
                               CanDrag="true" CanResize="false" KeepFocus="false" EdgeClass="bds-selection-edge"
                               IsDragging="@(PaneContext.SelectionMove.IsPending)"
                               DragStarted="drag => BeginMove(region, drag)"/>
        }

        <!-- now render the border around the whole region. No fill on active region because we've filled it already -->
        <BoxOverlayRenderer
            BackgroundVisible="@(!isActiveRegion)"
            BorderThickness="@(isActiveRegion ? "var(--selection-border-thickness)" : "0px")"
            X="GetLayerColumnX(boundedRegion.Left)"
            Y="GetLayerRowY(boundedRegion.Top)"
            Width="Sheet.Columns.GetVisualWidthBetween(boundedRegion.Left, boundedRegion.Right + 1)"
            Height="Sheet.Rows.GetVisualHeightBetween(boundedRegion.Top, boundedRegion.Bottom + 1)"
            ShowBorderLeft="boundedRegion.Left == region.Left"
            ShowBorderRight="boundedRegion.Right == Math.Min(region.Right, Sheet.NumCols-1)"
            ShowBorderTop="boundedRegion.Top == region.Top"
            ShowBorderBottom="boundedRegion.Bottom == Math.Min(region.Bottom, Sheet.NumRows-1)"/>
    }

    @if (Sheet.Selection.ActiveRegion != null)
    {
        <!-- the array formula's spill around the active cell, as Excel outlines it -->
        var activeCell = Sheet.Selection.ActiveCellPosition;
        var spill = Sheet.Cells.GetSpillRegion(activeCell.row, activeCell.col);
        var boundedSpill = spill?.GetIntersection(ViewRegion);
        if (spill != null && boundedSpill != null)
        {
            <BoxOverlayRenderer
                BackgroundVisible="false"
                BorderThickness="var(--spill-outline-thickness)"
                BorderColor="var(--spill-outline-color)"
                X="GetLayerColumnX(boundedSpill.Left)"
                Y="GetLayerRowY(boundedSpill.Top)"
                Width="Sheet.Columns.GetVisualWidthBetween(boundedSpill.Left, boundedSpill.Right + 1)"
                Height="Sheet.Rows.GetVisualHeightBetween(boundedSpill.Top, boundedSpill.Bottom + 1)"
                ShowBorderLeft="boundedSpill.Left == spill.Left"
                ShowBorderRight="boundedSpill.Right == spill.Right"
                ShowBorderTop="boundedSpill.Top == spill.Top"
                ShowBorderBottom="boundedSpill.Bottom == spill.Bottom"/>
        }
    }

    @if (Sheet.Selection.IsSelecting)
    {
        var selection = Sheet.Selection.SelectingRegion!;
        var boundedSelecting = selection.GetIntersection(ViewRegion);
        if (boundedSelecting != null)
        {
            <BoxOverlayRenderer
                BackgroundVisible="@true"
                BorderThickness="var(--selection-border-thickness)"
                X="@GetLayerColumnX(boundedSelecting.Left)"
                Y="@GetLayerRowY(boundedSelecting.Top)"
                Width="Sheet.Columns.GetVisualWidthBetween(boundedSelecting.Left, boundedSelecting.Right + 1)"
                Height="Sheet.Rows.GetVisualHeightBetween(boundedSelecting.Top, boundedSelecting.Bottom + 1)"
                ShowBorderLeft="boundedSelecting.Left == selection.Left"
                ShowBorderRight="boundedSelecting.Right == selection.Right"
                ShowBorderTop="boundedSelecting.Top == selection.Top"
                ShowBorderBottom="boundedSelecting.Bottom == selection.Bottom"/>
        }
    }
</div>

@code {
    [CascadingParameter] private PaneContext? PaneContext { get; set; }
    private SelectionMoveController? _moveController;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!ReferenceEquals(_moveController, PaneContext?.SelectionMove))
        {
            if (_moveController != null)
                _moveController.Changed -= MoveChanged;
            _moveController = PaneContext?.SelectionMove;
            if (_moveController != null)
                _moveController.Changed += MoveChanged;
        }
    }

    private void MoveChanged() => _ = InvokeAsync(StateHasChanged);

    private void BeginMove(IRegion region, HighlightBoxDrag drag)
    {
        var layout = new CellLayoutProvider(Sheet);
        var bounded = region.GetIntersection(Sheet.Region)!;
        var row = Math.Clamp(drag.Row ?? layout.ComputeRow(drag.LayerY + Top), bounded.Top, bounded.Bottom);
        var col = Math.Clamp(drag.Col ?? layout.ComputeColumn(drag.LayerX + Left), bounded.Left, bounded.Right);
        _moveController?.Begin(new CellPosition(row, col), drag.PageX, drag.PageY);
    }


    /// <summary>
    /// Whether the selection is shown while the user is working in another sheet of the workbook.
    /// </summary>
    [Parameter]
    public bool ShowWhenNotCurrentSheet { get; set; }

    private WorkbookViews? _workbookViews;

    protected override void OnSheetChange(Sheet newSheet, Sheet oldSheet)
    {
        oldSheet.Selection.SelectionChanged -= OnSelectionChanged;
        oldSheet.Selection.SelectingChanged -= OnSelectingChanged;
        oldSheet.Cells.RegionMerged -= OnMergesChanged;
        oldSheet.Cells.RegionUnMerged -= OnMergesChanged;
        oldSheet.Cells.SpillChanged -= OnSpillChanged;
        newSheet.Selection.SelectionChanged += OnSelectionChanged;
        newSheet.Selection.SelectingChanged += OnSelectingChanged;
        // the active cell is drawn around its merge
        newSheet.Cells.RegionMerged += OnMergesChanged;
        newSheet.Cells.RegionUnMerged += OnMergesChanged;
        newSheet.Cells.SpillChanged += OnSpillChanged;

        if (_workbookViews != null)
            _workbookViews.Changed -= OnCurrentSheetChanged;
        _workbookViews = DatasheetRegistry.For(newSheet.Workbook);
        _workbookViews.Changed += OnCurrentSheetChanged;
    }

    private void OnCurrentSheetChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnMergesChanged(object? sender, IRegion region) => StateHasChanged();
    private void OnSpillChanged(object? sender, SpillChangedEventArgs e) => StateHasChanged();

    private void OnSelectionChanged(object? sender, SelectionChangedEventArgs args)
    {
        StateHasChanged();
    }

    private void OnSelectingChanged(object? sender, IRegion? args)
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        if (_moveController != null)
            _moveController.Changed -= MoveChanged;
        Sheet.Selection.SelectionChanged -= OnSelectionChanged;
        Sheet.Selection.SelectingChanged -= OnSelectingChanged;
        Sheet.Cells.RegionMerged -= OnMergesChanged;
        Sheet.Cells.RegionUnMerged -= OnMergesChanged;
        Sheet.Cells.SpillChanged -= OnSpillChanged;
        if (_workbookViews != null)
            _workbookViews.Changed -= OnCurrentSheetChanged;
    }

}

@using BlazorDatasheet.DataStructures.Geometry
@using Microsoft.JSInterop
@using static BlazorDatasheet.Util.JsInteropHelper
@inject IJSRuntime Js
@implements IAsyncDisposable

<div @ref="_contentEl" class="bds-autoscroll"></div>

@code {

    private bool _enabled;

    /// <summary>
    /// Whether the auto-scroller is allowed to run.
    /// </summary>
    [Parameter]
    public bool Enabled { get; set; }

    [Parameter] public required AutoScrollOptions Options { get; set; } = new();
    [Parameter, EditorRequired] public required AutoScrollState State { get; set; }

    private ElementReference _contentEl;
    private IJSObjectReference? _autoScroller;
    private DotNetObjectReference<AutoScroller>? _dotnetHelper;
    private PeriodicTimer? _pt;
    private double _velX;
    private double _velY;
    private bool _isDisposed;

    protected override void OnParametersSet()
    {
        if (!Enabled)
        {
            _velX = 0;
            _velY = 0;
        }
        _enabled = Enabled;
        if (_pt != null)
            _pt.Period = TimeSpan.FromMilliseconds(Options.PollIntervalInMs);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isDisposed)
            return;

        var module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorDatasheet/Render/AutoScroll/AutoScroller.razor.js");

        if (_isDisposed)
        {
            await DisposeJsObjectReferenceAsync(module);
            return;
        }

        var dotnetHelper = DotNetObjectReference.Create(this);

        try
        {
            var autoScroller = await module.InvokeAsync<IJSObjectReference>("createAutoScroller");

            if (_isDisposed)
            {
                await SafeDisposeAutoScrollerAsync(autoScroller);
                return;
            }

            await autoScroller.InvokeVoidAsync("subscribe", _contentEl, dotnetHelper);

            if (_isDisposed)
            {
                await SafeDisposeAutoScrollerAsync(autoScroller);
                return;
            }

            _autoScroller = autoScroller;
            _dotnetHelper = dotnetHelper;
            dotnetHelper = null;
        }
        finally
        {
            dotnetHelper?.Dispose();
            await DisposeJsObjectReferenceAsync(module);
        }

        // not awaited - this loop runs for the lifetime of the component, and awaiting it here
        // would leave the render lifecycle task pending forever.
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        var pt = new PeriodicTimer(TimeSpan.FromMilliseconds(Options.PollIntervalInMs));
        _pt = pt;

        try
        {
            while (await pt.WaitForNextTickAsync())
            {
                if (_isDisposed || _autoScroller == null)
                    return;

                if (Math.Abs(pt.Period.TotalMilliseconds - Options.PollIntervalInMs) > double.Epsilon)
                    pt.Period = TimeSpan.FromMilliseconds(Options.PollIntervalInMs);

                if (_enabled && State.IsActive)
                {
                    await _autoScroller.InvokeVoidAsync("scrollBy", _velX, _velY);
                }
            }
        }
        catch (ObjectDisposedException)
        {
            // the timer was disposed while we were waiting on it
        }
        catch (JSDisconnectedException)
        {
            // circuit torn down mid-scroll
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        _pt?.Dispose();
        _pt = null;

        var autoScroller = _autoScroller;
        _autoScroller = null;
        var dotnetHelper = _dotnetHelper;
        _dotnetHelper = null;

        try
        {
            if (autoScroller != null)
                await SafeDisposeAutoScrollerAsync(autoScroller);
        }
        catch (Exception)
        {
            // ignored
        }
        finally
        {
            dotnetHelper?.Dispose();
        }
    }

    private static async Task SafeDisposeAutoScrollerAsync(IJSObjectReference autoScroller)
    {
        try
        {
            await autoScroller.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnects during server-side component teardown.
        }

        await DisposeJsObjectReferenceAsync(autoScroller);
    }

    [JSInvokable(nameof(HandleMouseOutsideOfScrollableAncestor))]
    public Task HandleMouseOutsideOfScrollableAncestor(Point2d point)
    {
        var p = 1.2;
        _velX = Math.Min(Math.Pow(Math.Abs(point.X), p), Options.MaxVelocity) * Math.Sign(point.X);
        _velY = Math.Min(Math.Pow(Math.Abs(point.Y), p), Options.MaxVelocity) * Math.Sign(point.Y);
        return Task.CompletedTask;
    }

}

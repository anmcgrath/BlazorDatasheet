@using BlazorDatasheet.Events
@using Microsoft.JSInterop
@using static BlazorDatasheet.Util.JsInteropHelper
@inject IJSRuntime Js
@implements IAsyncDisposable

<div @ref="_contentEl" class="bds-autoscroll"></div>

@code {
    /// <summary>
    /// Whether the auto-scroller is allowed to run.
    /// </summary>
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public required AutoScrollOptions Options { get; set; } = new();
    [Parameter, EditorRequired] public required AutoScrollState State { get; set; }
    [Parameter] public EventCallback<SheetPointerEventArgs> ScrollTargetChanged { get; set; }

    private ElementReference _contentEl;
    private IJSObjectReference? _autoScroller;
    private DotNetObjectReference<AutoScroller>? _dotnetHelper;
    private AutoScrollState? _subscribedState;
    private bool _isDisposed;
    private bool? _configuredEnabled;
    private double? _configuredMaxVelocity;
    private int? _configuredInterval;
    private double? _configuredEdgeThreshold;

    protected override void OnParametersSet()
    {
        var needsSync = _configuredEnabled != Enabled ||
                        _configuredMaxVelocity != Options.MaxVelocity ||
                        _configuredInterval != Options.PollIntervalInMs ||
                        _configuredEdgeThreshold != Options.EdgeThresholdPixels ||
                        !ReferenceEquals(_subscribedState, State);
        if (!ReferenceEquals(_subscribedState, State))
        {
            if (_subscribedState != null)
                _subscribedState.Changed -= HandleStateChanged;
            _subscribedState = State;
            State.Changed += HandleStateChanged;
        }

        _configuredEnabled = Enabled;
        _configuredMaxVelocity = Options.MaxVelocity;
        _configuredInterval = Options.PollIntervalInMs;
        _configuredEdgeThreshold = Options.EdgeThresholdPixels;
        if (needsSync)
            _ = InvokeAsync(SyncStateAsync);
    }

    private void HandleStateChanged() => _ = InvokeAsync(SyncStateAsync);

    private async Task SyncStateAsync()
    {
        if (_isDisposed || _autoScroller == null)
            return;

        var interval = Math.Max(1, Options.PollIntervalInMs);
        var speed = Math.Max(0, Options.MaxVelocity) * 1000 / interval;
        try
        {
            await _autoScroller.InvokeVoidAsync("configure", Enabled && State.IsActive,
                State.IsSheetSelectionActive || State.IsEditorSelectionActive,
                speed, Math.Max(0, Options.EdgeThresholdPixels));
        }
        catch (JSDisconnectedException)
        {
            // The circuit may close during an active drag.
        }
        catch (ObjectDisposedException)
        {
            // A queued state change may run after disposal.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isDisposed)
            return;

        var module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorDatasheet/Render/AutoScroll/AutoScroller.razor.js");

        if (_isDisposed)
        {
            await DisposeJsObjectReferenceAsync(module);
            return;
        }

        var dotnetHelper = DotNetObjectReference.Create(this);

        try
        {
            var autoScroller = await module.InvokeAsync<IJSObjectReference>("createAutoScroller");

            if (_isDisposed)
            {
                await SafeDisposeAutoScrollerAsync(autoScroller);
                return;
            }

            await autoScroller.InvokeVoidAsync("subscribe", _contentEl, dotnetHelper);

            if (_isDisposed)
            {
                await SafeDisposeAutoScrollerAsync(autoScroller);
                return;
            }

            _autoScroller = autoScroller;
            _dotnetHelper = dotnetHelper;
            dotnetHelper = null;
            await SyncStateAsync();
        }
        finally
        {
            dotnetHelper?.Dispose();
            await DisposeJsObjectReferenceAsync(module);
        }
    }

    [JSInvokable]
    public Task HandleScrollTarget(SheetPointerEventArgs target) =>
        _isDisposed || !Enabled || !(State.IsSheetSelectionActive || State.IsEditorSelectionActive)
            ? Task.CompletedTask
            : ScrollTargetChanged.InvokeAsync(target);

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        if (_subscribedState != null)
        {
            _subscribedState.Changed -= HandleStateChanged;
            _subscribedState = null;
        }

        var autoScroller = _autoScroller;
        _autoScroller = null;
        var dotnetHelper = _dotnetHelper;
        _dotnetHelper = null;

        try
        {
            if (autoScroller != null)
                await SafeDisposeAutoScrollerAsync(autoScroller);
        }
        catch (Exception)
        {
            // ignored
        }
        finally
        {
            dotnetHelper?.Dispose();
        }
    }

    private static async Task SafeDisposeAutoScrollerAsync(IJSObjectReference autoScroller)
    {
        try
        {
            await autoScroller.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
            // Ignore disconnects during server-side component teardown.
        }

        await DisposeJsObjectReferenceAsync(autoScroller);
    }
}

@using BlazorDatasheet.DataStructures.Geometry
@using BlazorDatasheet.Extensions
@using BlazorDatasheet.Virtualise
@inherits HeadingRenderer

<div style="display: flex; flex-direction: column;">
    @if (TopHeadingRegion != null && HasVisibleRows(TopHeadingRegion))
    {
        <div class="bds-sheet-row-head-container bds-frozen-top"
             style="position: sticky; top:var(--gutter-top-height); z-index: 4;">
            <Virtualise2D
                OverscanRows="OverscanRows"
                @ref="_topView"
                LayoutProvider="LayoutProvider"
                ViewRegion="TopHeadingRegion">
                <GridItemTemplate>
                    @RowHeadingItem(context.row)
                </GridItemTemplate>
            </Virtualise2D>
        </div>
    }

    @if (HasVisibleRows(MainHeadingRegion))
    {
        <div class="bds-sheet-row-head-container" style="z-index: 2; position: relative;">
            <Virtualise2D
                OverscanRows="OverscanRows"
                @ref="MainView"
                LayoutProvider="LayoutProvider"
                ViewRegion="MainHeadingRegion">
                <GridItemTemplate>
                    @RowHeadingItem(context.row)
                </GridItemTemplate>
            </Virtualise2D>
        </div>
    }

    @if (BottomHeadingRegion != null && HasVisibleRows(BottomHeadingRegion))
    {
        <div class="bds-sheet-row-head-container bds-frozen-bottom" style="position: sticky; bottom: 0; z-index: 4;">
            <Virtualise2D
                OverscanRows="OverscanRows"
                @ref="_bottomView"
                LayoutProvider="LayoutProvider"
                ViewRegion="BottomHeadingRegion">
                <GridItemTemplate>
                    @RowHeadingItem(context.row)
                </GridItemTemplate>
            </Virtualise2D>
        </div>
    }
</div>

@code {

    private RenderFragment RowHeadingItem(int row) =>
        @<div class="bds-row-head bds-sheet-cell @GetSelectedClass(row)" data-row="@row" data-col="-1">
            @ChildContent(new HeadingContext(row, _sheet.Rows.GetHeading(row)))
        </div>;

    /// <summary>
    /// The number of rows past the end of the viewport to render.
    /// </summary>
    [Parameter]
    public int OverscanRows { get; set; } = 6;

    // each of these is read a few times per render, so they are computed once and kept until the
    // view region, freeze state or row count changes.
    private bool _headingRegionsValid;
    private IRegion? _topHeadingRegion;
    private IRegion _mainHeadingRegion = new Region(0, 0);
    private IRegion? _bottomHeadingRegion;

    private IRegion? TopHeadingRegion
    {
        get
        {
            EnsureHeadingRegions();
            return _topHeadingRegion;
        }
    }

    private IRegion MainHeadingRegion
    {
        get
        {
            EnsureHeadingRegions();
            return _mainHeadingRegion;
        }
    }

    private IRegion? BottomHeadingRegion
    {
        get
        {
            EnsureHeadingRegions();
            return _bottomHeadingRegion;
        }
    }

    private void EnsureHeadingRegions()
    {
        if (_headingRegionsValid)
            return;

        _topHeadingRegion = _viewRegion.GetIntersection(_sheet.GetFrozenTopRegion());
        _mainHeadingRegion = new Region(_sheet.FreezeState.Top, _viewRegion.Bottom - _sheet.FreezeState.Bottom, 0, 0);
        _bottomHeadingRegion = _viewRegion.GetIntersection(_sheet.GetFrozenBottomRegion());
        _headingRegionsValid = true;
    }

    protected override void InvalidateHeadingRegions()
    {
        _headingRegionsValid = false;
    }

    private bool HasVisibleRows(IRegion? region) => _sheet.HasVisibleRows(region);

}

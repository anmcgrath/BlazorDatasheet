    [Test]
    public void Datasheet_Sheet_Replacement_Moves_Heading_Subscriptions_To_New_Sheet()
    {
        var oldSheet = new Sheet(2, 2);
        var newSheet = new Sheet(2, 2);
        var cut = RenderComponent<Datasheet>(parameters => parameters.Add(p => p.Sheet, oldSheet));

        CountEventHandlers<HeadingRenderer>(oldSheet.Selection, "SelectionChanged").Should().BeGreaterThan(0);

        cut.SetParametersAndRender(parameters => parameters.Add(p => p.Sheet, newSheet));

        CountEventHandlers<HeadingRenderer>(oldSheet.Selection, "SelectionChanged").Should().Be(0);
        CountEventHandlers<HeadingRenderer>(newSheet.Selection, "SelectionChanged").Should().BeGreaterThan(0);
    }

    [Test]
    public void Editor_Layer_Disposal_Removes_Editor_Subscriptions()
    {
        var sheet = new Sheet(3, 3);
        var cut = RenderComponent<Datasheet>(parameters => parameters.Add(p => p.Sheet, sheet));

        CountEventHandlers<EditorLayer>(sheet.Editor, "EditBegin").Should().BeGreaterThan(0);
        CountEventHandlers<EditorLayer>(sheet.Editor, "EditFinished").Should().BeGreaterThan(0);
        CountEventHandlers<EditorLayer>(sheet.Editor, "EditValueChanged").Should().BeGreaterThan(0);

        foreach (var editorLayer in cut.FindComponents<EditorLayer>())
            editorLayer.Instance.Dispose();

        CountEventHandlers<EditorLayer>(sheet.Editor, "EditBegin").Should().Be(0);
        CountEventHandlers<EditorLayer>(sheet.Editor, "EditFinished").Should().Be(0);
        CountEventHandlers<EditorLayer>(sheet.Editor, "EditValueChanged").Should().Be(0);
    }

    [Test]
    public void Datasheet_Disposal_Removes_Render_Layer_Subscriptions()
    {
        var sheet = new Sheet(2, 2);
        var cut = RenderComponent<Datasheet>(parameters =>
        {
            parameters.Add(p => p.Sheet, sheet);
            parameters.Add(p => p.ShowFormulaDependents, true);
        });

        CountEventHandlers<SelectionRendererLayer>(sheet.Selection, "SelectionChanged").Should().BeGreaterThan(0);
        CountEventHandlers<VirtualMergesLayer>(sheet.Cells, "CellsChanged").Should().BeGreaterThan(0);
        CountEventHandlers<FormulaDependenciesLayer>(sheet.Cells, "FormulaChanged").Should().BeGreaterThan(0);

        var selectionLayer = cut.FindComponent<SelectionRendererLayer>().Instance;
        var virtualMergesLayer = cut.FindComponent<VirtualMergesLayer>().Instance;
        var formulaDependenciesLayer = cut.FindComponent<FormulaDependenciesLayer>().Instance;

        selectionLayer.Should().BeAssignableTo<IDisposable>();
        virtualMergesLayer.Should().BeAssignableTo<IDisposable>();
        formulaDependenciesLayer.Should().BeAssignableTo<IDisposable>();

        ((IDisposable)selectionLayer).Dispose();
        ((IDisposable)virtualMergesLayer).Dispose();
        ((IDisposable)formulaDependenciesLayer).Dispose();

        CountEventHandlers<SelectionRendererLayer>(sheet.Selection, "SelectionChanged").Should().Be(0);
        CountEventHandlers<VirtualMergesLayer>(sheet.Cells, "CellsChanged").Should().Be(0);
        CountEventHandlers<FormulaDependenciesLayer>(sheet.Cells, "FormulaChanged").Should().Be(0);
    }

    [Test]
    public async Task Merged_Cell_Dimensions_Update_After_Resize_And_Visibility_Changes()
    {
        var sheet = new Sheet(2, 3);
        sheet.Cells.Merge(new Region(0, 1, 0, 2));
        var cut = RenderComponent<Datasheet>(parameters => parameters.Add(p => p.Sheet, sheet));
        var mergedContent = () => cut.Find(".merged-cell > div");

        mergedContent().GetAttribute("style").Should().Contain($"width: {sheet.Columns.GetVisualWidthBetween(0, 3)}px");

        await cut.InvokeAsync(() => sheet.Columns.SetSize(2, 175));
        cut.WaitForAssertion(() => mergedContent().GetAttribute("style").Should()
            .Contain($"width: {sheet.Columns.GetVisualWidthBetween(0, 3)}px"));

        await cut.InvokeAsync(() => sheet.Columns.Hide(1, 1));
        cut.WaitForAssertion(() => mergedContent().GetAttribute("style").Should()
            .Contain($"width: {sheet.Columns.GetVisualWidthBetween(0, 3)}px"));

        await cut.InvokeAsync(() => sheet.Columns.Unhide(1, 1));
        cut.WaitForAssertion(() => mergedContent().GetAttribute("style").Should()
            .Contain($"width: {sheet.Columns.GetVisualWidthBetween(0, 3)}px"));
    }

    [Test]
    public async Task Datasheet_Tracks_Sheet_Selection_AutoScroll_State()
    {
        var sheet = new Sheet(4, 4);
        var cut = RenderComponent<Datasheet>(parameters => { parameters.Add(p => p.Sheet, sheet); });
        var autoScrollState = GetAutoScrollState(cut.Instance);

        autoScrollState.IsSheetSelectionActive.Should().BeFalse();
        autoScrollState.IsActive.Should().BeFalse();

        await cut.InvokeAsync(() => sheet.Selection.BeginSelectingCell(0, 0));

        autoScrollState.IsSheetSelectionActive.Should().BeTrue();
        autoScrollState.IsActive.Should().BeTrue();

        await cut.InvokeAsync(sheet.Selection.EndSelecting);

        autoScrollState.IsSheetSelectionActive.Should().BeFalse();
        autoScrollState.IsActive.Should().BeFalse();
    }

    [Test]
    public async Task Datasheet_Clears_Editor_AutoScroll_State_When_Edit_Finishes()
    {
        TrackingAutoScrollEditor.LastInstance = null;

        var sheet = new Sheet(4, 4);
        sheet.Cells[0, 0]!.Type = "tracking";

        var cut = RenderComponent<Datasheet>(parameters =>
        {
            parameters.Add(p => p.Sheet, sheet);
            parameters.Add(p => p.CustomCellTypeDefinitions, new Dictionary<string, CellTypeDefinition>
            {
                { "tracking", CellTypeDefinition.Create<TrackingAutoScrollEditor, TextRenderer>() }
            });
        });

        var autoScrollState = GetAutoScrollState(cut.Instance);

        await cut.InvokeAsync(() => sheet.Editor.BeginEdit(0, 0));
        cut.WaitForAssertion(() => TrackingAutoScrollEditor.LastInstance.Should().NotBeNull());

        await cut.InvokeAsync(() => TrackingAutoScrollEditor.LastInstance!.SetTrackedAutoScroll(true));
        autoScrollState.IsEditorSelectionActive.Should().BeTrue();
        autoScrollState.IsActive.Should().BeTrue();

        await cut.InvokeAsync(sheet.Editor.CancelEdit);

        autoScrollState.IsEditorSelectionActive.Should().BeFalse();
        autoScrollState.IsActive.Should().BeFalse();
    }

    [Test]
    public async Task Insert_Row_At_End_Renders_New_Row_Cells()
    {
        var sheet = new Sheet(3, 3);

        var cut = RenderComponent<Datasheet>(parameters =>
        {
            parameters.Add(p => p.Sheet, sheet);
            parameters.Add(p => p.ShowColHeadings, false);
            parameters.Add(p => p.ShowRowHeadings, false);
        });

        await cut.InvokeAsync(() =>
        {
            cut.Instance.ForceReRender();
            sheet.Rows.InsertAt(sheet.NumRows);
            sheet.Cells.SetValue(3, 0, "New");
        });

        cut.FindAll("div.bds-sheet-cell[data-row='3']").Should().NotBeEmpty();
    }

    private static AutoScrollState GetAutoScrollState(Datasheet datasheet)
    {
        var field = typeof(Datasheet).GetField("_autoScrollState", BindingFlags.Instance | BindingFlags.NonPublic);
        field.Should().NotBeNull();
        return field!.GetValue(datasheet).Should().BeOfType<AutoScrollState>().Subject;
    }

    private static int CountEventHandlers<TTarget>(object source, string eventName)
    {
        for (var type = source.GetType(); type != null; type = type.BaseType)
        {
            var field = type.GetField(eventName, BindingFlags.Instance | BindingFlags.NonPublic);
            if (field?.GetValue(source) is Delegate eventDelegate)
                return eventDelegate.GetInvocationList().Count(x => x.Target is TTarget);
        }

        return 0;
    }

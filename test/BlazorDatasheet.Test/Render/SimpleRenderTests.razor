    {
        var sheet = new Sheet(4, 4);
        var menuOptions = new SheetMenuOptions();

        RenderComponent<Datasheet>(parameters =>
        {
            parameters.Add(p => p.Sheet, sheet);
            parameters.Add(p => p.MenuOptions, menuOptions);
            parameters.Add(p => p.MenuItems, (RenderFragment<Sheet>)(s => @<div>custom</div>));
        });


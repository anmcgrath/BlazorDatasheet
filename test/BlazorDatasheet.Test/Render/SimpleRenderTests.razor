    [Test]
    public async Task Editor_Overlay_Max_Size_Uses_Both_Layer_Axes()
    {
        var sheet = new Sheet(3, 3);

        var cut = RenderComponent<Datasheet>(parameters => { parameters.Add(p => p.Sheet, sheet); });

        await cut.InvokeAsync(() =>
        {
            cut.Instance.ForceReRender();
            sheet.Editor.BeginEdit(1, 1);
        });

        var expectedWidth = sheet.Columns.GetVisualWidthBetween(0, sheet.NumCols);
        var expectedHeight = sheet.Rows.GetVisualHeightBetween(0, sheet.NumRows);
        // guard the test itself - the axes must differ for this to detect a mix-up
        expectedWidth.Should().NotBe(expectedHeight);

        var editor = cut.Find("div.bds-editor-overlay");
        editor.GetStyle().GetMaxWidth().Should().Be(expectedWidth + "px");
        editor.GetStyle().GetMaxHeight().Should().Be(expectedHeight + "px");
    }

    [Test]
    public async Task Setting_Column_Headings_At_Runtime_Updates_Rendered_Heading()
    {
        var sheet = new Sheet(3, 3);
        var cut = RenderComponent<Datasheet>(parameters => { parameters.Add(p => p.Sheet, sheet); });

        // headings are virtualised - a size change refreshes the heading viewport so items exist
        await cut.InvokeAsync(() => sheet.Columns.SetSize(0, 90));
        cut.WaitForAssertion(() => cut.Markup.Should().Contain("A"));
        cut.Markup.Should().NotContain("Renamed");

        await cut.InvokeAsync(() => sheet.Columns.SetHeadings(0, 0, "Renamed"));

        cut.WaitForAssertion(() => cut.Markup.Should().Contain("Renamed"));
    }

    [Test]
    public async Task Changing_Column_Header_Template_At_Runtime_ReRenders_Headings()
    {
        var sheet = new Sheet(3, 3);
        var cut = RenderComponent<Datasheet>(parameters =>
        {
            parameters.Add(p => p.Sheet, sheet);
            parameters.Add(p => p.ColumnHeaderTemplate, (RenderFragment<HeadingContext>)(ctx => @<div>before</div>));
        });

        // headings are virtualised - a size change refreshes the heading viewport so items exist
        await cut.InvokeAsync(() => sheet.Columns.SetSize(0, 90));
        cut.WaitForAssertion(() => cut.Markup.Should().Contain("before"));

        cut.SetParametersAndRender(parameters => parameters.Add(
            p => p.ColumnHeaderTemplate,
            (RenderFragment<HeadingContext>)(ctx => @<div>after</div>)));

        cut.Markup.Should().Contain("after");
        cut.Markup.Should().NotContain("before");
    }


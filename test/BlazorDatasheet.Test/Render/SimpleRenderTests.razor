    [Test]
    public async Task Datasheet_Runtime_ReadOnly_And_Precision_Changes_ReRender_Existing_Cells()
    {
        var sheet = new Sheet(1, 2);
        sheet.Cells.SetValue(0, 0, true);
        sheet.Cells[0, 0]!.Type = "boolean";
        sheet.Cells.SetValue(0, 1, 1.234567);
        var cut = RenderComponent<Datasheet>(parameters =>
        {
            parameters.Add(p => p.Sheet, sheet);
            parameters.Add(p => p.IsReadOnly, false);
            parameters.Add(p => p.NumberPrecisionDisplay, 2);
        });

        await cut.InvokeAsync(() =>
        {
            cut.Instance.ForceReRender();
            sheet.Cells.SetValue(0, 1, 1.234567);
        });

        cut.Find("input[type='checkbox']").HasAttribute("disabled").Should().BeFalse();
        cut.Find("div.bds-sheet-cell[data-col='1'] .bds-cell-container").TextContent.Should().Be("1.23");

        cut.SetParametersAndRender(parameters =>
        {
            parameters.Add(p => p.IsReadOnly, true);
            parameters.Add(p => p.NumberPrecisionDisplay, 4);
        });

        cut.Find("input[type='checkbox']").HasAttribute("disabled").Should().BeTrue();
        cut.Find("div.bds-sheet-cell[data-col='1'] .bds-cell-container").TextContent.Should().Be("1.2346");
    }

